<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RelumiScript.ViewModels"
        xmlns:models="using:RelumiScript.Models"
        xmlns:cv="using:RelumiScript.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        Width="1000" Height="700"
        x:Class="RelumiScript.HintEditorWindow"
        Title="Unified Definition Editor"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        x:DataType="vm:HintEditorViewModel">

	<Window.Resources>
		<cv:StringListConverter x:Key="StringListConverter"/>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="TextBlock.h1">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="Opacity" Value="0.7"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="30, *, 50">
		<Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False">
			<TextBlock Text="Unified Definition Editor" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="250, *" Margin="10,0,10,0">

			<Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,10,0">
				<TextBox Grid.Row="0" Text="{Binding SearchText}" Watermark="Search Commands..." Margin="0,0,0,10"/>

				<ListBox Grid.Row="1" ItemsSource="{Binding FilteredHints}" SelectedItem="{Binding SelectedHint}" Background="#1E1E1E">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:HintViewModel">
							<TextBlock Text="{Binding Cmd}" Padding="5"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<Button Grid.Row="2" Content="+ Add New Command" Command="{Binding AddHint}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
			</Grid>

			<Border Grid.Column="1" Background="#252526" CornerRadius="5" Padding="20" IsVisible="{Binding SelectedHint, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ScrollViewer>
					<StackPanel DataContext="{Binding SelectedHint}" x:DataType="vm:HintViewModel" Spacing="20">

						<StackPanel>
							<TextBlock Text="Command Definition" Classes="h1"/>
							<Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="0,0,0,10">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Classes="label"/>
								<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Cmd}" Margin="0,0,0,10"/>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="Hover Def:" Classes="label"/>
								<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Watermark="Short description shown on hover"/>
							</Grid>
						</StackPanel>

						<Separator Background="#3E3E42" Height="2"/>

						<StackPanel>
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Text="Parameters" Classes="h1"/>
								<Button Grid.Column="1" Content="+ Add Param" Command="{Binding AddParam}" Padding="10,2"/>
							</Grid>

							<ItemsControl ItemsSource="{Binding Params}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:HintParamViewModel">
										<Expander Margin="0,2" IsExpanded="True" Background="#1E1E1E">
											<Expander.Header>
												<Grid ColumnDefinitions="30, 150, *">
													<TextBlock Text="{Binding Model.Index, StringFormat='Arg {0}'}" VerticalAlignment="Center" Opacity="0.5"/>
													<TextBlock Grid.Column="1" Text="{Binding Model.Ref}" FontWeight="Bold" VerticalAlignment="Center"/>

													<ItemsControl Grid.Column="2" ItemsSource="{Binding Types}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" Spacing="5"/>
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<Border Background="#333" CornerRadius="3" Padding="5,2">
																	<TextBlock Text="{Binding}" FontSize="10" Opacity="0.8"/>
																</Border>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Grid>
											</Expander.Header>

											<StackPanel Spacing="10" Margin="10">
												<Grid ColumnDefinitions="Auto, *, Auto, *">
													<TextBlock Text="Ref Name:" Classes="label"/>
													<TextBox Grid.Column="1" Text="{Binding Model.Ref}"/>

													<TextBlock Grid.Column="2" Text="Depends On:" Classes="label" Margin="10,0,10,0"/>
													<TextBox Grid.Column="3" Text="{Binding Model.DependsOn}"/>
												</Grid>

												<Grid ColumnDefinitions="Auto, *">
													<TextBlock Text="Param Desc:" Classes="label"/>
													<TextBox Grid.Column="1" Text="{Binding Description}" Watermark="Parameter description (optional)"/>
												</Grid>

												<Grid ColumnDefinitions="Auto, *">
													<TextBlock Text="Accepted Types:" Classes="label" VerticalAlignment="Top" Margin="0,5,10,0"/>

													<StackPanel Grid.Column="1" Spacing="5">
														<ItemsControl ItemsSource="{Binding Types}">
															<ItemsControl.ItemsPanel>
																<ItemsPanelTemplate>
																	<WrapPanel Orientation="Horizontal" />
																</ItemsPanelTemplate>
															</ItemsControl.ItemsPanel>
															<ItemsControl.ItemTemplate>
																<DataTemplate>
																	<Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,5,5">
																		<StackPanel Orientation="Horizontal" Spacing="5">
																			<TextBlock Text="{Binding}" VerticalAlignment="Center"/>
																			<Button Content="x"
																					Command="{Binding $parent[ItemsControl].((vm:HintParamViewModel)DataContext).RemoveType}"
																					CommandParameter="{Binding}"
																					Background="Transparent" BorderThickness="0" Padding="2,0"
																					VerticalAlignment="Center" FontSize="10" Foreground="#FF5555"/>
																		</StackPanel>
																	</Border>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>

														<StackPanel Orientation="Horizontal" Spacing="5">
															<ComboBox ItemsSource="{Binding AvailableTypes}"
																	  SelectedItem="{Binding SelectedTypeToAdd}"
																	  PlaceholderText="Select Type..." Width="150"/>
															<Button Content="Add Type" Command="{Binding AddType}"/>
														</StackPanel>
													</StackPanel>
												</Grid>

												<Separator Background="#3E3E42" Height="1"/>

												<Grid ColumnDefinitions="*, Auto">
													<TextBlock Text="Sentence Fragments (Auto-Generated)" FontWeight="SemiBold" Opacity="0.8"/>
												</Grid>

												<ItemsControl ItemsSource="{Binding Fragments}">
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="vm:FragmentItem">
															<Grid ColumnDefinitions="100, *, 30" Margin="0,2">
																<TextBlock Text="{Binding Type}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,5,0" FontWeight="Bold"/>
																<TextBox Grid.Column="1" Text="{Binding Text}"/>
																<Button Grid.Column="2" Content="x"
																		Command="{Binding $parent[ItemsControl].((vm:HintParamViewModel)DataContext).RemoveFragment}"
																		CommandParameter="{Binding}"
																		Background="Transparent" Foreground="#FF5555"/>
															</Grid>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<Button Content="Delete Parameter"
														Command="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).RemoveParam}"
														CommandParameter="{Binding}"
														HorizontalAlignment="Right" Background="#552222" Margin="0,10,0,0"/>
											</StackPanel>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<Separator Background="#3E3E42" Height="2"/>

						<StackPanel>
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Text="Main Comment Construction" Classes="h1"/>
								<Button Grid.Column="1" Content="+ Add Part" Command="{Binding AddSentencePart}" Padding="10,2"/>
							</Grid>

							<TextBlock Text="Combine text with {RefName} placeholders." FontSize="12" Opacity="0.6" Margin="0,0,0,5"/>

							<ItemsControl ItemsSource="{Binding SentenceParts}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:HintSentencePartDef">
										<Border Background="#1E1E1E" CornerRadius="3" Margin="0,2" Padding="5">
											<Grid ColumnDefinitions="Auto, *, Auto, Auto">
												<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
													<TextBlock Text="If" Opacity="0.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
													<ComboBox ItemsSource="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).Params}"
															  SelectedItem="{Binding Check, Mode=TwoWay}"
															  Width="100" PlaceholderText="(Always)">
														<ComboBox.ItemTemplate>
															<DataTemplate x:DataType="vm:HintParamViewModel">
																<TextBlock Text="{Binding Model.Ref}"/>
															</DataTemplate>
														</ComboBox.ItemTemplate>
													</ComboBox>
												</StackPanel>

												<TextBox Grid.Column="1" Text="{Binding Text}" Watermark="Text (e.g. ', holding a {item}')"/>
												<CheckBox Grid.Column="2" IsChecked="{Binding ShowZero}" Content="Show if 0" Margin="10,0"/>

												<Button Grid.Column="3" Content="x"
														Command="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).RemoveSentencePart}"
														CommandParameter="{Binding}"
														Background="Transparent" Foreground="#FF5555" Margin="5,0,0,0"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<Button Content="Remove Command"
								Command="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).RemoveHint}"
								CommandParameter="{Binding}"
								HorizontalAlignment="Right" Background="#552222" Margin="0,20,0,0"/>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<TextBlock Grid.Column="1" Text="Select a command to edit"
					   VerticalAlignment="Center" HorizontalAlignment="Center"
					   Opacity="0.3" IsVisible="{Binding SelectedHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
		</Grid>

		<Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" Spacing="10">
				<Button Content="Cancel" Click="OnCancel_Click" Background="Transparent" BorderBrush="#555" BorderThickness="1"/>
				<Button Content="Save All Changes" Click="OnSave_Click" Background="#4EC9B0" Foreground="Black" FontWeight="Bold"/>
			</StackPanel>
		</Border>

	</Grid>
</Window>