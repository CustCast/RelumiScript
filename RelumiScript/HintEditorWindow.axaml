<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RelumiScript.ViewModels"
        xmlns:models="using:RelumiScript.Models"
        xmlns:cv="using:RelumiScript.Converters"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        Width="1100" Height="700"
        x:Class="RelumiScript.HintEditorWindow"
        Title="Unified Definition Editor"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        x:DataType="vm:HintEditorViewModel">

	<Window.Resources>
		<cv:StringListConverter x:Key="StringListConverter"/>
		<vm:ColorToBrushConverter x:Key="ColorToBrush"/>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="TextBlock.h1">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="Opacity" Value="0.7"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#444"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Padding" Value="6,4"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#444"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Padding" Value="10,5"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="35, *, 50"
          Background="{Binding Theme.Colors.WindowBackground, Converter={StaticResource ColorToBrush}}"
          TextElement.Foreground="{Binding Theme.Colors.TextColor, Converter={StaticResource ColorToBrush}}">

		<Grid Grid.Row="0" IsHitTestVisible="False" Background="{Binding Theme.Colors.PanelBackground, Converter={StaticResource ColorToBrush}}">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
				<TextBlock Text="💠" Foreground="{Binding Theme.Colors.AccentColor, Converter={StaticResource ColorToBrush}}"/>
				<TextBlock Text="Unified Definition Editor" Opacity="0.8" FontWeight="SemiBold"/>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="260, *" Margin="15">

			<Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,15,0">
				<TextBox Grid.Row="0" Text="{Binding SearchText}" Watermark="Search Commands..." Margin="0,0,0,10"
                         Background="{Binding Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                         Foreground="{Binding Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                         CaretBrush="{Binding Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>

				<Border Grid.Row="1" CornerRadius="4" BorderBrush="#333" BorderThickness="1" Background="{Binding Theme.Colors.SidebarBackground, Converter={StaticResource ColorToBrush}}">
					<ListBox ItemsSource="{Binding FilteredHints}" SelectedItem="{Binding SelectedHint}" Background="Transparent">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:HintViewModel">
								<TextBlock Text="{Binding Cmd}"/>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Border>

				<Button Grid.Row="2" Content="+ Add New Command" Command="{Binding AddHint}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                        Background="{Binding Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                        Foreground="{Binding Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
			</Grid>

			<Border Grid.Column="1" CornerRadius="5" Padding="20" BorderBrush="#333" BorderThickness="1"
                    Background="{Binding Theme.Colors.SidebarBackground, Converter={StaticResource ColorToBrush}}"
                    IsVisible="{Binding SelectedHint, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ScrollViewer>
					<StackPanel DataContext="{Binding SelectedHint}" x:DataType="vm:HintViewModel" Spacing="15">

						<StackPanel>
							<TextBlock Text="Command Definition" Classes="h1"/>
							<Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="0,0,0,5">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Classes="label"/>
								<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Cmd}" Margin="0,0,0,10"
                                         Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                         Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                         CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>

								<TextBlock Grid.Row="1" Grid.Column="0" Text="Hover Def:" Classes="label"/>
								<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Watermark="Short description shown on hover"
                                         Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                         Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                         CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
							</Grid>
						</StackPanel>

						<Separator Background="#3E3E42" Height="1" Margin="0,5"/>

						<StackPanel>
							<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
								<TextBlock Text="Parameters" Classes="h1" Margin="0"/>
								<Button Content="+ Add Param" Command="{Binding AddParam}" Padding="8,2" FontSize="12"
                                        Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                        Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
							</Grid>

							<ItemsControl ItemsSource="{Binding Params}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:HintParamViewModel">
										<Expander Margin="0,0,0,8" IsExpanded="True"
                                                  Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.PanelBackground, Converter={StaticResource ColorToBrush}}">
											<Expander.Header>
												<Grid ColumnDefinitions="40, 150, *">
													<TextBlock Text="{Binding Model.Index, StringFormat='Arg {0}'}" VerticalAlignment="Center" Opacity="0.5" FontSize="11"/>
													<TextBlock Grid.Column="1" Text="{Binding Model.Ref}" FontWeight="Bold" VerticalAlignment="Center"/>

													<ItemsControl Grid.Column="2" ItemsSource="{Binding Types}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" Spacing="5"/>
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<Border CornerRadius="3" Padding="6,2" BorderBrush="#444" BorderThickness="1"
                                                                        Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}">
																	<TextBlock Text="{Binding}" FontSize="10" Opacity="0.8"/>
																</Border>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Grid>
											</Expander.Header>

											<Grid ColumnDefinitions="*, 20, *" Margin="10">

												<StackPanel Grid.Column="0" Spacing="10">
													<Grid ColumnDefinitions="*, 10, *">
														<StackPanel Grid.Column="0">
															<TextBlock Text="Ref Name" Classes="label" FontSize="10" Margin="0,0,0,2"/>
															<TextBox Text="{Binding Model.Ref}"
                                                                     Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                     Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                                                     CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
														</StackPanel>
														<StackPanel Grid.Column="2">
															<TextBlock Text="Depends On (Arg Index)" Classes="label" FontSize="10" Margin="0,0,0,2"/>
															<TextBox Text="{Binding Model.DependsOn}"
                                                                     Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                     Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                                                     CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
														</StackPanel>
													</Grid>

													<StackPanel>
														<TextBlock Text="Description" Classes="label" FontSize="10" Margin="0,0,0,2"/>
														<TextBox Text="{Binding Description}" Watermark="Optional description"
                                                                 Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                 Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                                                 CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
													</StackPanel>

													<StackPanel>
														<TextBlock Text="Accepted Types" Classes="label" FontSize="10" Margin="0,0,0,5"/>
														<WrapPanel Orientation="Horizontal">
															<ItemsControl ItemsSource="{Binding Types}">
																<ItemsControl.ItemsPanel>
																	<ItemsPanelTemplate>
																		<WrapPanel Orientation="Horizontal" />
																	</ItemsPanelTemplate>
																</ItemsControl.ItemsPanel>
																<ItemsControl.ItemTemplate>
																	<DataTemplate>
																		<Border CornerRadius="10" Padding="8,2" Margin="0,0,5,5"
                                                                                Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.ActivityBarBackground, Converter={StaticResource ColorToBrush}}">
																			<StackPanel Orientation="Horizontal" Spacing="5">
																				<TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="11"/>
																				<Button Content="×"
																						Command="{Binding $parent[ItemsControl].((vm:HintParamViewModel)DataContext).RemoveType}"
																						CommandParameter="{Binding}"
																						Background="Transparent" BorderThickness="0" Padding="0"
																						VerticalAlignment="Center" FontSize="12" Foreground="#FF5555"/>
																			</StackPanel>
																		</Border>
																	</DataTemplate>
																</ItemsControl.ItemTemplate>
															</ItemsControl>

															<StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,5">
																<ComboBox ItemsSource="{Binding AvailableTypes}"
																		  SelectedItem="{Binding SelectedTypeToAdd}"
																		  PlaceholderText="Add Type..." Width="100" FontSize="11" Height="24" Padding="4,0"
                                                                          Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                          Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
																<Button Content="+" Command="{Binding AddType}" Padding="5,0"
                                                                        Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                        Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
															</StackPanel>
														</WrapPanel>
													</StackPanel>
												</StackPanel>

												<Rectangle Grid.Column="1" Width="1" Fill="#333" HorizontalAlignment="Center"/>

												<DockPanel Grid.Column="2">
													<Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,5">
														<TextBlock Text="Sentence Fragments" FontWeight="SemiBold" Opacity="0.8" FontSize="11"/>
														<Button Content="+ Add" Command="{Binding AddFragment}" Padding="5,0" FontSize="10"
                                                                Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
													</Grid>

													<Button DockPanel.Dock="Bottom" Content="Delete Parameter"
															Command="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).RemoveParam}"
															CommandParameter="{Binding}"
															Background="Transparent" BorderThickness="0" Foreground="#FF6B6B"
                                                            HorizontalAlignment="Right" Margin="0,10,0,0" FontSize="11"/>

													<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
														<ItemsControl ItemsSource="{Binding Fragments}">
															<ItemsControl.ItemTemplate>
																<DataTemplate x:DataType="vm:FragmentItem">
																	<Grid ColumnDefinitions="80, *, Auto, Auto" Margin="0,2">
																		<TextBox Text="{Binding Type}" FontWeight="Bold" FontSize="11" Margin="0,0,5,0" ToolTip.Tip="Type Key (e.g. Pokemon, Value)"
                                                                                 Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                                 Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                                                                 CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
																		<TextBox Grid.Column="1" Text="{Binding Text}" FontSize="11" ToolTip.Tip="Text replacement"
                                                                                 Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                                                                 Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                                                                 CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
																		<CheckBox Grid.Column="2" IsChecked="{Binding ShowZero}" Content="Show 0" FontSize="10" Margin="5,0,0,0"/>
																		<Button Grid.Column="3" Content="×"
																				Command="{Binding $parent[ItemsControl].((vm:HintParamViewModel)DataContext).RemoveFragment}"
																				CommandParameter="{Binding}"
																				Background="Transparent" BorderThickness="0" Foreground="#FF5555" Padding="5,0"/>
																	</Grid>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</ScrollViewer>
												</DockPanel>
											</Grid>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<Separator Background="#3E3E42" Height="1" Margin="0,5"/>

						<StackPanel>
							<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
								<TextBlock Text="Main Comment Construction" Classes="h1" Margin="0"/>
								<Button Content="+ Add Part" Command="{Binding AddSentencePart}" Padding="8,2" FontSize="12"
                                        Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                                        Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
							</Grid>

							<TextBlock Text="Combine text with {RefName} placeholders. Hidden values (0) become empty."
									   FontSize="11" Opacity="0.6" Margin="0,0,0,5" FontStyle="Italic"/>

							<ItemsControl ItemsSource="{Binding SentenceParts}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:HintSentencePartDef">
										<Border CornerRadius="15" Margin="0,2,5,2" Padding="8,4" BorderBrush="#444" BorderThickness="1"
                                                Background="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}">
											<StackPanel Orientation="Horizontal" Spacing="5">
												<TextBox Text="{Binding Text}" MinWidth="100" BorderThickness="0" Background="Transparent" Padding="0"
                                                         Foreground="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"
                                                         CaretBrush="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
												<Button Content="×"
														Command="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).RemoveSentencePart}"
														CommandParameter="{Binding}"
														Background="Transparent" BorderThickness="0" Foreground="#FF5555" VerticalAlignment="Center"/>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<Button Content="Remove Entire Command"
								Command="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).RemoveHint}"
								CommandParameter="{Binding}"
								Background="Transparent" BorderThickness="0" Foreground="#FF6B6B"
                                HorizontalAlignment="Right" Margin="0,20,0,0"/>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<TextBlock Grid.Column="1" Text="Select a command to edit"
					   VerticalAlignment="Center" HorizontalAlignment="Center"
					   Opacity="0.3" IsVisible="{Binding SelectedHint, Converter={x:Static ObjectConverters.IsNull}}"/>
		</Grid>

		<Border Grid.Row="2" BorderBrush="#333" BorderThickness="0,1,0,0" Background="{Binding Theme.Colors.PanelBackground, Converter={StaticResource ColorToBrush}}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0" Spacing="10" VerticalAlignment="Center">
				<Button Content="Cancel" Click="OnCancel_Click"
                        Background="{Binding Theme.Colors.InputBackground, Converter={StaticResource ColorToBrush}}"
                        Foreground="{Binding Theme.Colors.InputForeground, Converter={StaticResource ColorToBrush}}"/>
				<Button Content="Save All Changes" Click="OnSave_Click" FontWeight="Bold"
                        Background="{Binding Theme.Colors.AccentColor, Converter={StaticResource ColorToBrush}}"
                        Foreground="White"/>
			</StackPanel>
		</Border>

	</Grid>
</Window>