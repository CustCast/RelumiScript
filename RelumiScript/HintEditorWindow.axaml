<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RelumiScript.ViewModels"
        xmlns:models="using:RelumiScript.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        Width="900" Height="600"
        x:Class="RelumiScript.HintEditorWindow"
        Title="Hint Editor"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        x:DataType="vm:HintEditorViewModel">

	<Window.Styles>
		<Style Selector="TextBlock.h1">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="Opacity" Value="0.7"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="30, *, 50">
		<Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False">
			<TextBlock Text="Hint Editor" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="250, *" Margin="10,0,10,0">

			<Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,10,0">
				<TextBox Grid.Row="0" Text="{Binding SearchText}" Watermark="Search Commands..." Margin="0,0,0,10"/>

				<ListBox Grid.Row="1" ItemsSource="{Binding FilteredHints}" SelectedItem="{Binding SelectedHint}" Background="#1E1E1E">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:HintViewModel">
							<TextBlock Text="{Binding Cmd}" Padding="5"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<Button Grid.Row="2" Content="+ Add New Command" Command="{Binding AddHint}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
			</Grid>

			<Border Grid.Column="1" Background="#252526" CornerRadius="5" Padding="20" IsVisible="{Binding SelectedHint, Converter={x:Static ObjectConverters.IsNotNull}}">
				<ScrollViewer>
					<StackPanel DataContext="{Binding SelectedHint}" x:DataType="vm:HintViewModel" Spacing="20">

						<StackPanel>
							<TextBlock Text="Command Definition" Classes="h1"/>
							<Grid ColumnDefinitions="Auto, *">
								<TextBlock Text="Command Name:" Classes="label"/>
								<TextBox Grid.Column="1" Text="{Binding Cmd}"/>
							</Grid>
						</StackPanel>

						<Separator Background="#3E3E42" Height="2"/>

						<StackPanel>
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Text="Parameters" Classes="h1"/>
								<Button Grid.Column="1" Content="+" Command="{Binding AddParam}" Padding="10,2"/>
							</Grid>

							<Border BorderBrush="#3E3E42" BorderThickness="1" Background="#1E1E1E" Padding="5">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>

									<Grid Grid.Row="0" ColumnDefinitions="40, 100, 150, 80, 40" Margin="0,0,0,5">
										<TextBlock Text="#" FontWeight="Bold" HorizontalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="Type" FontWeight="Bold" Margin="5,0"/>
										<TextBlock Grid.Column="2" Text="Ref Name" FontWeight="Bold" Margin="5,0"/>
										<TextBlock Grid.Column="3" Text="Dep. On" FontWeight="Bold" Margin="5,0"/>
									</Grid>

									<ItemsControl Grid.Row="1" ItemsSource="{Binding Params}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="models:HintParamDef">
												<Grid ColumnDefinitions="40, 100, 150, 80, 40" Margin="0,2">
													<TextBlock Text="{Binding Index}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

													<ComboBox Grid.Column="1" SelectedItem="{Binding Type}" Margin="2,0">
														<ComboBox.Items>
															<x:String>Value</x:String>
															<x:String>Pokemon</x:String>
															<x:String>Item</x:String>
															<x:String>Form</x:String>
															<x:String>Ball</x:String>
														</ComboBox.Items>
													</ComboBox>

													<TextBox Grid.Column="2" Text="{Binding Ref}" Margin="2,0"/>
													<TextBox Grid.Column="3" Text="{Binding DependsOn}" Watermark="idx" Margin="2,0"/>

													<Button Grid.Column="4" Content="x"
															Command="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).RemoveParam}"
															CommandParameter="{Binding}"
															Background="Transparent" Foreground="#FF5555"/>
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
							</Border>
						</StackPanel>

						<Separator Background="#3E3E42" Height="2"/>

						<StackPanel>
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Text="Sentence Builder" Classes="h1"/>
								<Button Grid.Column="1" Content="+" Command="{Binding AddSentencePart}" Padding="10,2"/>
							</Grid>

							<TextBlock Text="Builds the tooltip text. 'Check' makes a part conditional on a parameter."
									   FontSize="12" Opacity="0.6" Margin="0,0,0,5"/>

							<ItemsControl ItemsSource="{Binding SentenceParts}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:HintSentencePartDef">
										<Border Background="#1E1E1E" CornerRadius="3" Margin="0,2" Padding="5">
											<Grid ColumnDefinitions="Auto, *, Auto, Auto">

												<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
													<TextBlock Text="If" Opacity="0.5" Margin="0,0,5,0" VerticalAlignment="Center"/>

													<ComboBox ItemsSource="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).Params}"
															  SelectedItem="{Binding Check, Mode=TwoWay}"
															  Width="100" PlaceholderText="(Always)">
														<ComboBox.ItemTemplate>
															<DataTemplate x:DataType="models:HintParamDef">
																<TextBlock Text="{Binding Ref}"/>
															</DataTemplate>
														</ComboBox.ItemTemplate>
													</ComboBox>
												</StackPanel>

												<TextBox Grid.Column="1" Text="{Binding Text}" Watermark="Text segment (e.g. ', holding a {item}')"/>

												<CheckBox Grid.Column="2" IsChecked="{Binding ShowZero}" Content="Show if 0" Margin="10,0"/>

												<Button Grid.Column="3" Content="x"
														Command="{Binding $parent[StackPanel].((vm:HintViewModel)DataContext).RemoveSentencePart}"
														CommandParameter="{Binding}"
														Background="Transparent" Foreground="#FF5555" Margin="5,0,0,0"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<Button Content="Remove This Command"
								Command="{Binding $parent[Window].((vm:HintEditorViewModel)DataContext).RemoveHint}"
								CommandParameter="{Binding}"
								HorizontalAlignment="Right" Background="#552222" Margin="0,20,0,0"/>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<TextBlock Grid.Column="1" Text="Select a command to edit"
					   VerticalAlignment="Center" HorizontalAlignment="Center"
					   Opacity="0.3" IsVisible="{Binding SelectedHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
		</Grid>

		<Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" Spacing="10">
				<Button Content="Cancel" Click="OnCancel_Click" Background="Transparent" BorderBrush="#555" BorderThickness="1"/>
				<Button Content="Save Changes" Click="OnSave_Click" Background="#4EC9B0" Foreground="Black" FontWeight="Bold"/>
			</StackPanel>
		</Border>

	</Grid>
</Window>