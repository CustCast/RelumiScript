<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RelumiScript"
        xmlns:models="clr-namespace:RelumiScript.Models"
        xmlns:webview="using:AvaloniaWebView"
        x:Class="RelumiScript.MainWindow"
        x:Name="MainWindowRef"
        x:CompileBindings="False"
        Title="Relumi Script Viewer" Height="700" Width="1200"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeTextColor}"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Padding="{Binding $self.OffScreenMargin}"
        KeyDown="OnWindowKeyDown">

	<Window.Resources>
		<local:ScriptPreviewConverter x:Key="ScriptPreviewConverter" />
		<local:SearchTypeToIconConverter x:Key="SearchTypeToIconConverter" />
	</Window.Resources>

	<Window.Styles>
		<Style Selector="ToolTip">
			<Setter Property="MaxWidth" Value="1200"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="Button.ActivityButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="50"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeActivityForeground}"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="FontFamily" Value="Segoe UI Symbol"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>

		<Style Selector="Button.ActivityButton:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource ThemeActivityActiveForeground}"/>
		</Style>
		<Style Selector="Button.ActivityButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="Button.ActivityButton.Active">
			<Setter Property="Foreground" Value="{DynamicResource ThemeActivityActiveForeground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentColor}"/>
			<Setter Property="BorderThickness" Value="2,0,0,0"/>
		</Style>

		<Style Selector="Button.PanelButton">
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeInputForeground}"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="2"/>
		</Style>
		<Style Selector="Button.PanelButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#444"/>
		</Style>
		<Style Selector="Button.PanelButton:disabled /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.5"/>
			<Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/>
		</Style>

		<Style Selector="TreeViewItem">
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Padding" Value="2,0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextColor}"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#37373D"/>
		</Style>
		<Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#2A2D2E"/>
		</Style>

		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextColor}"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="ListBox.TabStrip">
			<Setter Property="Background" Value="{DynamicResource ThemePanelBackground}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem">
			<Setter Property="Background" Value="#2D2D2D"/>
			<Setter Property="Foreground" Value="#969696"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Margin" Value="1,0,0,0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem:selected">
			<Setter Property="Background" Value="{DynamicResource ThemeWindowBackground}"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeTextColor}"/>
			<Setter Property="BorderThickness" Value="0,1,0,0"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentColor}"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ThemeWindowBackground}"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ThemeWindowBackground}"/>
		</Style>

		<Style Selector="Expander">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="Expander.SearchExpander">
			<Setter Property="Template">
				<ControlTemplate>
					<StackPanel>
						<ToggleButton x:Name="PART_toggle" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
							<ToggleButton.Template>
								<ControlTemplate>
									<Border Background="Transparent" Padding="2">
										<Grid ColumnDefinitions="20, *">
											<Path x:Name="Arrow" Grid.Column="0" Data="M 6 4 L 10 8 L 6 12"
                                                  Stroke="{DynamicResource ThemeTextColor}" StrokeThickness="1.5" Fill="Transparent"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Width="16" Height="16" Stretch="None"/>
											<ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
										</Grid>
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
							<ContentPresenter Content="{TemplateBinding Header}" />
						</ToggleButton>
						<ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
					</StackPanel>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Expander.SearchExpander:expanded /template/ ToggleButton#PART_toggle Path#Arrow">
			<Setter Property="Data" Value="M 4 6 L 8 10 L 12 6"/>
		</Style>

		<Style Selector="ScrollBar">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ScrollBar:vertical">
			<Setter Property="Width" Value="10"/>
		</Style>
		<Style Selector="ScrollBar:horizontal">
			<Setter Property="Height" Value="10"/>
		</Style>

		<Style Selector="ScrollBar /template/ Thumb">
			<Setter Property="Background" Value="#424242"/>
		</Style>
		<Style Selector="ScrollBar /template/ Thumb:pointerover">
			<Setter Property="Background" Value="#4F4F4F"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="30, *, 25">

		<Grid Grid.Row="0" Background="{DynamicResource ThemePanelBackground}" PointerPressed="TitleBar_PointerPressed">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0" Spacing="8">
				<TextBlock Text="💠" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccentColor}"/>
				<TextBlock Text="Relumi Script Viewer" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.9" FontWeight="SemiBold"/>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1" x:Name="SidebarGrid" ColumnDefinitions="50, 300, 4, *">

			<Border Grid.Column="0" Background="{DynamicResource ThemeActivityBarBackground}">
				<Grid RowDefinitions="*, Auto">
					<StackPanel Grid.Row="0">
						<Button Classes="ActivityButton" x:Name="BtnNavFile" Click="OnSidebarNav_Click" Tag="File" ToolTip.Tip="File Operations">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasOpen}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.OpenIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="📂" IsVisible="{Binding !ThemeVm.Icons.HasOpen}" />
							</Panel>
						</Button>

						<Rectangle Height="1" Fill="#444" Margin="10,5"/>

						<Button Classes="ActivityButton" x:Name="BtnNavExplorer" Click="OnSidebarNav_Click" Tag="Explorer" ToolTip.Tip="Explorer (Ctrl+Shift+E)">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasExplorer}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.ExplorerIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="📁" IsVisible="{Binding !ThemeVm.Icons.HasExplorer}" />
							</Panel>
						</Button>

						<Button Classes="ActivityButton" x:Name="BtnNavSearch" Click="OnSidebarNav_Click" Tag="Search" ToolTip.Tip="Search (Ctrl+Shift+F)">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasSearch}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.SearchIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="🔍" IsVisible="{Binding !ThemeVm.Icons.HasSearch}" />
							</Panel>
						</Button>

						<Button Classes="ActivityButton" x:Name="BtnNavFlags" Click="OnSidebarNav_Click" Tag="Flags" ToolTip.Tip="Unused Flags">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasFlags}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.FlagsIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="🚩" IsVisible="{Binding !ThemeVm.Icons.HasFlags}" />
							</Panel>
						</Button>

						<Button Classes="ActivityButton" x:Name="BtnNavCommands" Click="OnSidebarNav_Click" Tag="Commands" ToolTip.Tip="Unused Works">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasCommands}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.CommandsIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="🔨" IsVisible="{Binding !ThemeVm.Icons.HasCommands}" />
							</Panel>
						</Button>

						<Button Classes="ActivityButton" x:Name="BtnNavTheme" Click="OnSidebarNav_Click" Tag="Theme" ToolTip.Tip="Theme Settings">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasTheme}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.ThemeIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="🎨" IsVisible="{Binding !ThemeVm.Icons.HasTheme}" />
							</Panel>
						</Button>
					</StackPanel>

					<StackPanel Grid.Row="1">
						<Button Classes="ActivityButton" x:Name="BtnNavPreview" Click="OnBottomNav_Click" Tag="Preview" ToolTip.Tip="Message Preview">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasPreview}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.PreviewIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="👁" IsVisible="{Binding !ThemeVm.Icons.HasPreview}" />
							</Panel>
						</Button>

						<Button Classes="ActivityButton" x:Name="BtnNavTerminal" Click="OnBottomNav_Click" Tag="Terminal" ToolTip.Tip="Terminal (Ctrl+`)">
							<Panel>
								<Rectangle Width="24" Height="24" IsVisible="{Binding ThemeVm.Icons.HasTerminal}" Fill="{Binding $parent[Button].Foreground}">
									<Rectangle.OpacityMask>
										<ImageBrush Source="{Binding ThemeVm.Icons.TerminalIcon}" Stretch="Uniform"/>
									</Rectangle.OpacityMask>
								</Rectangle>
								<TextBlock Text="💻" IsVisible="{Binding !ThemeVm.Icons.HasTerminal}" />
							</Panel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Column="1" Background="{DynamicResource ThemeSidebarBackground}" x:Name="SidePanelContainer">
				<Grid>
					<Grid x:Name="PanelFile" IsVisible="False" RowDefinitions="35, *">
						<Border Grid.Row="0" Padding="10,0" Background="{DynamicResource ThemeSidebarBackground}">
							<TextBlock Text="FILE OPERATIONS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
						</Border>
						<StackPanel Grid.Row="1" Margin="10">
							<Button Classes="PanelButton" Content="📂 Load Project" Click="BtnLoad_Click"/>
							<Button Classes="PanelButton" Content="💾 Save Changed Scripts (.ev)" Click="BtnSave_Click"/>
							<Button Classes="PanelButton" Content="📦 Unpack Bundle" IsEnabled="False"/>
							<Button Classes="PanelButton" Content="📦 Pack Bundle" IsEnabled="False"/>
						</StackPanel>
					</Grid>

					<Grid x:Name="PanelExplorer" RowDefinitions="35, 35, *">
						<Border Grid.Row="0" Padding="10,0" Background="{DynamicResource ThemeSidebarBackground}">
							<TextBlock Text="EXPLORER" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
						</Border>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="{DynamicResource ThemeInputBackground}" CornerRadius="2">
							<TextBox x:Name="ExplorerSearchBox" Watermark="Search files..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeInputForeground}" TextChanged="ExplorerSearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<TreeView Grid.Row="2" x:Name="ScriptTree" Background="{DynamicResource ThemeSidebarBackground}" BorderThickness="0" SelectionChanged="ScriptTree_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
							<TreeView.DataTemplates>
								<TreeDataTemplate DataType="models:FileNode" ItemsSource="{Binding Scripts}">
									<Grid ColumnDefinitions="Auto, *" Background="Transparent" DoubleTapped="OnExplorerItem_DoubleTapped">
										<TextBlock Text="{Binding Icon}" Foreground="#4EC9B0" Margin="0,0,6,0" FontFamily="Segoe UI Symbol"/>
										<TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource ThemeTextColor}" TextTrimming="CharacterEllipsis"/>
									</Grid>
								</TreeDataTemplate>
								<DataTemplate DataType="models:ScriptNode">
									<StackPanel Orientation="Horizontal" Background="Transparent" DoubleTapped="OnExplorerItem_DoubleTapped">
										<TextBlock Text="Js" Foreground="#D7BA7D" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
										<TextBlock Text="{Binding Label}" Foreground="#D7BA7D"/>
									</StackPanel>
								</DataTemplate>
							</TreeView.DataTemplates>
						</TreeView>
					</Grid>

					<Grid x:Name="PanelSearch" IsVisible="False" RowDefinitions="35, 35, *">
						<Border Grid.Row="0" Padding="10,0" Background="{DynamicResource ThemeSidebarBackground}">
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Text="SEARCH" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
								<Button Grid.Column="1" Content="↻" Padding="4,0" ToolTip.Tip="Refresh Search Index" Background="Transparent" Click="RefreshFlags_Click" BorderThickness="0"/>
							</Grid>
						</Border>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="{DynamicResource ThemeInputBackground}" CornerRadius="2">
							<TextBox x:Name="SearchBox" Watermark="Global search..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeInputForeground}" TextChanged="SearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<ListBox Grid.Row="2" x:Name="SearchResultsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel/>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Expander Classes="SearchExpander" HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="0" Margin="0">
										<Expander.Header>
											<Grid ColumnDefinitions="Auto, Auto, *" Margin="2,0,0,0">
												<TextBlock Text="{Binding Type, Converter={StaticResource SearchTypeToIconConverter}}" Foreground="{Binding Color}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI Symbol"/>
												<TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="#569CD6" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding Id}"/>
												<TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource ThemeTextColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
											</Grid>
										</Expander.Header>
										<ItemsControl ItemsSource="{Binding Locations}" Background="Transparent" BorderThickness="0" Margin="0">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="25,2,5,2" Click="JumpToLocation_Click" PointerWheelChanged="SearchResult_PointerWheelChanged" Tag="{Binding}" ToolTip.Placement="Right">
														<ToolTip.Tip>
															<Border Background="{DynamicResource ThemeWindowBackground}" BorderBrush="White" BorderThickness="1" Padding="10" MaxWidth="1200" MaxHeight="700">
																<ScrollViewer>
																	<ItemsControl>
																		<ItemsControl.ItemsSource>
																			<MultiBinding Converter="{StaticResource ScriptPreviewConverter}">
																				<Binding Path="NodeObject"/>
																				<Binding Path="LineNumber"/>
																				<Binding Path="#MainWindowRef.ThemeVm"/>
																			</MultiBinding>
																		</ItemsControl.ItemsSource>
																		<ItemsControl.ItemTemplate>
																			<DataTemplate>
																				<Border Background="{Binding Background}" Padding="2,0">
																					<StackPanel Orientation="Horizontal">
																						<TextBlock Text="{Binding LineNumber}" Width="35" Foreground="#808080" FontFamily="Consolas" FontSize="11" Margin="0,0,10,0"/>
																						<ItemsControl ItemsSource="{Binding Segments}">
																							<ItemsControl.ItemsPanel>
																								<ItemsPanelTemplate>
																									<StackPanel Orientation="Horizontal"/>
																								</ItemsPanelTemplate>
																							</ItemsControl.ItemsPanel>
																							<ItemsControl.ItemTemplate>
																								<DataTemplate>
																									<TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontWeight="{Binding Weight}" FontStyle="{Binding Style}" FontFamily="Consolas" FontSize="11"/>
																								</DataTemplate>
																							</ItemsControl.ItemTemplate>
																						</ItemsControl>
																					</StackPanel>
																				</Border>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																</ScrollViewer>
															</Border>
														</ToolTip.Tip>
														<Grid ColumnDefinitions="Auto, *">
															<TextBlock Text="{Binding Command}" Foreground="#DCDCAA" FontSize="11" Margin="5,0"/>
															<TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#808080" FontSize="10" FontStyle="Italic" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Expander>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<Grid x:Name="PanelFlags" IsVisible="False" RowDefinitions="35, 35, *">
						<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,0">
							<TextBlock Text="UNUSED FLAGS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
							<Button Grid.Column="1" Content="↻" Padding="4,0" ToolTip.Tip="Refresh" Background="Transparent" Click="RefreshFlags_Click" BorderThickness="0"/>
						</Grid>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="{DynamicResource ThemeInputBackground}" CornerRadius="2">
							<TextBox x:Name="FlagSearchBox" Watermark="Filter flags..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeInputForeground}" TextChanged="FlagSearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<ListBox Grid.Row="2" x:Name="FlagList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="Auto, *">
										<TextBlock Text="🚩" Foreground="#569CD6" Margin="0,0,6,0" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="{Binding FlagName}" Foreground="{DynamicResource ThemeTextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<Grid x:Name="PanelCommands" IsVisible="False" RowDefinitions="35, 35, *">
						<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,0">
							<TextBlock Text="UNUSED WORKS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
							<Button Grid.Column="1" Content="↻" Padding="4,0" ToolTip.Tip="Refresh" Background="Transparent" Click="RefreshScripts_Click" BorderThickness="0"/>
						</Grid>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="{DynamicResource ThemeInputBackground}" CornerRadius="2">
							<TextBox x:Name="ScriptSearchBox" Watermark="Filter works..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeInputForeground}" TextChanged="ScriptSearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<ListBox Grid.Row="2" x:Name="ScriptList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="Auto, *">
										<TextBlock Text="🔨" Foreground="#CE9178" Margin="0,0,6,0" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="{Binding FlagName}" Foreground="{DynamicResource ThemeTextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<Grid x:Name="PanelTheme" IsVisible="False" RowDefinitions="Auto, 35, Auto, *">
						<Grid Grid.Row="0" Margin="10,10,10,5">
							<TextBlock Text="THEME SETTINGS" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
						</Grid>

						<Grid Grid.Row="1" Margin="10,0" ColumnDefinitions="*, Auto">
							<ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding CurrentThemeName, Mode=TwoWay}"
									  HorizontalAlignment="Stretch" Margin="0,0,5,0" SelectionChanged="ThemeComboBox_SelectionChanged"
                                      Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0"/>
							<Button Grid.Column="1" Content="+" Width="30" ToolTip.Tip="Create New Theme" Click="BtnNewTheme_Click" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}"/>
						</Grid>

						<Border Grid.Row="2" Margin="10" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Background="{Binding Colors.BackgroundColor}" Padding="10">
							<StackPanel x:Name="PreviewBox">
								<TextBlock Text="// RelumiScript Theme Preview" Foreground="{Binding Syntax.Comment.Brush}" FontStyle="{Binding Syntax.Comment.FontStyle}" FontWeight="{Binding Syntax.Comment.Weight}" FontSize="11" FontFamily="Consolas"/>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="Script " Foreground="{Binding Syntax.ScriptLabel.Brush}" FontStyle="{Binding Syntax.ScriptLabel.FontStyle}" FontWeight="{Binding Syntax.ScriptLabel.Weight}" FontSize="11" FontFamily="Consolas"/>
									<TextBlock Text="Work_100 " Foreground="{Binding Syntax.WorkVar.Brush}" FontStyle="{Binding Syntax.WorkVar.FontStyle}" FontWeight="{Binding Syntax.WorkVar.Weight}" FontSize="11" FontFamily="Consolas"/>
									<TextBlock Text="Cmd_01 " Foreground="{Binding Syntax.Command.Brush}" FontStyle="{Binding Syntax.Command.FontStyle}" FontWeight="{Binding Syntax.Command.Weight}" FontSize="11" FontFamily="Consolas"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="  Flag " Foreground="{Binding Syntax.Command.Brush}" FontStyle="{Binding Syntax.Command.FontStyle}" FontWeight="{Binding Syntax.Command.Weight}" FontSize="11" FontFamily="Consolas"/>
									<TextBlock Text="#123 " Foreground="{Binding Syntax.Flag.Brush}" FontStyle="{Binding Syntax.Flag.FontStyle}" FontWeight="{Binding Syntax.Flag.Weight}" FontSize="11" FontFamily="Consolas"/>
									<TextBlock Text="$SYS_01 " Foreground="{Binding Syntax.SysFlag.Brush}" FontStyle="{Binding Syntax.SysFlag.FontStyle}" FontWeight="{Binding Syntax.SysFlag.Weight}" FontSize="11" FontFamily="Consolas"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<ScrollViewer Grid.Row="3" Margin="10,0">
							<Border Padding="0,0,10,10">
								<StackPanel Spacing="10">
									<TextBlock Text="UI Colors" FontWeight="Bold" Foreground="#888" FontSize="12" Margin="0,5"/>

									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Window Background" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.WindowBackground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Sidebar Background" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.SidebarBackground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Panel Background" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.PanelBackground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Activity Bar" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.ActivityBarBackground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Accent Color" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.AccentColor, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Text Color" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.TextColor, Mode=TwoWay}" />
									</Grid>

									<TextBlock Text="Input &amp; Interactive" FontWeight="Bold" Foreground="#888" FontSize="12" Margin="0,5"/>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Input Background" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.InputBackground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Input Text" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.InputForeground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Activity Icon" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.ActivityForeground, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Activity Selected" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.ActivityActiveForeground, Mode=TwoWay}" />
									</Grid>

									<TextBlock Text="Icon Configuration (Filename in 'Icons' folder)" FontWeight="Bold" Foreground="#888" FontSize="12" Margin="0,15,0,5"/>
									<Grid ColumnDefinitions="*, 120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
										<TextBlock Grid.Row="0" Text="Open Folder" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Icons.Open, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="1" Text="Explorer" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Icons.Explorer, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="2" Text="Search" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Icons.Search, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="3" Text="Flags" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Icons.Flags, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="4" Text="Commands" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Icons.Commands, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="5" Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Icons.Theme, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="6" Text="Preview" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Icons.Preview, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>

										<TextBlock Grid.Row="7" Text="Terminal" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Icons.Terminal, Mode=TwoWay}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeInputForeground}" BorderThickness="0" Margin="0,2"/>
									</Grid>

									<TextBlock Text="Editor General" FontWeight="Bold" Foreground="#888" FontSize="12" Margin="0,15,0,5"/>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Editor Background" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.BackgroundColor, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Editor Foreground" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Colors.ForegroundColor, Mode=TwoWay}" />
									</Grid>

									<TextBlock Text="Syntax Highlighting" FontWeight="Bold" Foreground="#888" FontSize="12" Margin="0,15,0,5"/>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Script Label" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.ScriptLabel.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Work Variable" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.WorkVar.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Flag" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.Flag.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="System Flag" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.SysFlag.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Command" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.Command.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Number" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.Number.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="String" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.String.Color, Mode=TwoWay}" />
									</Grid>
									<Grid ColumnDefinitions="*, Auto">
										<TextBlock Text="Comment" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextColor}"/>
										<ColorPicker Grid.Column="1" Color="{Binding Syntax.Comment.Color, Mode=TwoWay}" />
									</Grid>

									<Grid ColumnDefinitions="*, Auto" Margin="0,20,0,0">
										<Button Content="Reset (Reload)" Click="BtnResetTheme_Click" Background="#444" Foreground="#CCC" Margin="0,0,10,0"/>
										<Button Grid.Column="1" Content="Save Current Theme" Click="SaveTheme_Click" Background="{DynamicResource ThemeAccentColor}" Foreground="White"/>
									</Grid>
								</StackPanel>
							</Border>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>

			<GridSplitter Grid.Column="2" Background="{DynamicResource ThemeSidebarBackground}" ResizeDirection="Columns"/>

			<Grid x:Name="MainContentGrid" Grid.Column="3" Background="{DynamicResource ThemeWindowBackground}" RowDefinitions="30, *, 4, Auto">

				<ListBox Grid.Row="0" x:Name="TabStrip" Classes="TabStrip" SelectionChanged="TabStrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid ColumnDefinitions="*, Auto" MinWidth="100">
								<TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeTextColor}" FontSize="12" VerticalAlignment="Center" Margin="5,0,10,0" FontStyle="{Binding FontStyle}"/>
								<Button Grid.Column="1" Content="✕" Click="BtnCloseTab_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextColor}" Padding="2" FontSize="10" VerticalAlignment="Center"/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<Panel Grid.Row="1" Background="{DynamicResource ThemeWindowBackground}">
					<webview:WebView x:Name="Editor" IsVisible="True"/>
					<Grid x:Name="NoTabsPlaceholder" IsVisible="False" Background="Transparent" PointerPressed="OnPlaceholder_PointerPressed">
						<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
							<TextBlock Text="Relumi Script Viewer" FontSize="24" Foreground="{DynamicResource ThemeTextColor}" HorizontalAlignment="Center"/>
							<TextBlock Text="Click anywhere to open project" FontSize="14" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,10,0,0"/>
						</StackPanel>
					</Grid>
				</Panel>

				<GridSplitter Grid.Row="2" Background="{DynamicResource ThemePanelBackground}" ResizeDirection="Rows" IsVisible="{Binding #BottomPanelContainer.IsVisible}"/>

				<Grid Grid.Row="3" x:Name="BottomPanelContainer" IsVisible="False" Height="250" Background="{DynamicResource ThemePanelBackground}">

					<Border x:Name="PreviewPanel" IsVisible="False" Background="{DynamicResource ThemePanelBackground}" BorderBrush="#333" BorderThickness="0,1,0,0">
						<Grid RowDefinitions="Auto, *">
							<Border Grid.Row="0" Padding="10,5" Background="{DynamicResource ThemePanelBackground}">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="PREVIEW" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11"/>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
										<Button x:Name="BtnPrevPage" Content="◀" Padding="8,2" Background="Transparent" BorderThickness="0" Click="BtnPrevPage_Click" IsVisible="False"/>
										<TextBlock x:Name="PageIndicator" Text="" VerticalAlignment="Center" Foreground="#888" FontSize="11" IsVisible="False"/>
										<Button x:Name="BtnNextPage" Content="▶" Padding="8,2" Background="Transparent" BorderThickness="0" Click="BtnNextPage_Click" IsVisible="False"/>
										<Button Content="✕" Padding="5,0" Background="Transparent" BorderThickness="0" Click="BtnPreviewClose_Click" Foreground="{DynamicResource ThemeTextColor}" FontSize="10" Margin="10,0,0,0"/>
									</StackPanel>
								</Grid>
							</Border>
							<Border Grid.Row="1" Padding="10" Background="{DynamicResource ThemeWindowBackground}">
								<Viewbox Stretch="Uniform">
									<ContentControl x:Name="MessagePreviewContent"/>
								</Viewbox>
							</Border>
						</Grid>
					</Border>

					<Border x:Name="TerminalPanel" IsVisible="False" Background="{DynamicResource ThemePanelBackground}" BorderBrush="#333" BorderThickness="0,1,0,0">
						<Grid RowDefinitions="Auto, *">
							<Border Grid.Row="0" Padding="10,5" Background="{DynamicResource ThemePanelBackground}">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="TERMINAL (PowerShell)" FontWeight="Bold" Foreground="{DynamicResource ThemeTextColor}" Opacity="0.7" FontSize="11"/>
									<Button Grid.Column="1" Content="✕" Padding="5,0" Background="Transparent" BorderThickness="0" Click="BtnTerminalClose_Click" Foreground="{DynamicResource ThemeTextColor}" FontSize="10"/>
								</Grid>
							</Border>
							<webview:WebView x:Name="TerminalWebView" Grid.Row="1" />
						</Grid>
					</Border>
				</Grid>
			</Grid>
		</Grid>

		<Border Grid.Row="2" Background="{DynamicResource ThemeAccentColor}" Padding="10,0">
			<TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
		</Border>
	</Grid>
</Window>