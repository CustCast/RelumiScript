<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RelumiScript"
        xmlns:models="clr-namespace:RelumiScript.Models"
        xmlns:webview="using:AvaloniaWebView"
        x:Class="RelumiScript.MainWindow"
        x:Name="MainWindowRef"
        x:CompileBindings="False"
        Title="Relumi Script Viewer" Height="700" Width="1200"
        Background="#1E1E1E" Foreground="#CCCCCC"
        FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol">

	<Window.Resources>
		<local:ScriptPreviewConverter x:Key="ScriptPreviewConverter" />
		<local:SearchTypeToIconConverter x:Key="SearchTypeToIconConverter" />
	</Window.Resources>

	<Window.Styles>
		<Style Selector="ToolTip">
			<Setter Property="MaxWidth" Value="1200"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TreeViewItem">
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Padding" Value="2,0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Foreground" Value="#CCCCCC"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#37373D"/>
		</Style>
		<Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#2A2D2E"/>
		</Style>

		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Foreground" Value="#CCCCCC"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="ListBox.TabStrip">
			<Setter Property="Background" Value="#252526"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem">
			<Setter Property="Background" Value="#2D2D2D"/>
			<Setter Property="Foreground" Value="#969696"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Margin" Value="1,0,0,0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem:selected">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderThickness" Value="0,1,0,0"/>
			<Setter Property="BorderBrush" Value="#007ACC"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="#1E1E1E"/>
		</Style>
		<Style Selector="ListBox.TabStrip ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1E1E1E"/>
		</Style>

		<Style Selector="Expander">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="Expander.SearchExpander">
			<Setter Property="Template">
				<ControlTemplate>
					<StackPanel>
						<ToggleButton x:Name="PART_toggle" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
							<ToggleButton.Template>
								<ControlTemplate>
									<Border Background="Transparent" Padding="2">
										<Grid ColumnDefinitions="20, *">
											<Path x:Name="Arrow" Grid.Column="0" Data="M 6 4 L 10 8 L 6 12"
                                                  Stroke="#CCCCCC" StrokeThickness="1.5" Fill="Transparent"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Width="16" Height="16" Stretch="None"/>
											<ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
										</Grid>
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
							<ContentPresenter Content="{TemplateBinding Header}" />
						</ToggleButton>
						<ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
					</StackPanel>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="Expander.SearchExpander:expanded /template/ ToggleButton#PART_toggle Path#Arrow">
			<Setter Property="Data" Value="M 4 6 L 8 10 L 12 6"/>
		</Style>

		<Style Selector="ScrollBar">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Width" Value="10"/>
			<Setter Property="Height" Value="10"/>
		</Style>
		<Style Selector="ScrollBar /template/ Thumb">
			<Setter Property="Background" Value="#424242"/>
		</Style>
		<Style Selector="ScrollBar /template/ Thumb:pointerover">
			<Setter Property="Background" Value="#4F4F4F"/>
		</Style>

		<Style Selector="Button.ActivityButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Width" Value="50"/>
			<Setter Property="Height" Value="50"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="#858585"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="FontFamily" Value="Segoe UI Symbol"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="Button.ActivityButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#E0E0E0"/>
		</Style>
		<Style Selector="Button.ActivityButton.Active">
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#FFFFFF"/>
			<Setter Property="BorderThickness" Value="2,0,0,0"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="*, 22">

		<Grid Grid.Row="0" x:Name="SidebarGrid" ColumnDefinitions="50, 300, 4, *">

			<Border Grid.Column="0" Background="#333333">
				<Grid RowDefinitions="*, Auto">
					<StackPanel Grid.Row="0">
						<Button Classes="ActivityButton" x:Name="BtnActionOpen" Click="BtnLoad_Click" ToolTip.Tip="Open Folder (Ctrl+O)">📂</Button>
						<Rectangle Height="1" Fill="#444" Margin="10,5"/>
						<Button Classes="ActivityButton" x:Name="BtnNavExplorer" Click="OnSidebarNav_Click" Tag="Explorer" ToolTip.Tip="Explorer (Ctrl+Shift+E)">📁</Button>
						<Button Classes="ActivityButton" x:Name="BtnNavSearch" Click="OnSidebarNav_Click" Tag="Search" ToolTip.Tip="Search (Ctrl+Shift+F)">🔍</Button>
						<Button Classes="ActivityButton" x:Name="BtnNavFlags" Click="OnSidebarNav_Click" Tag="Flags" ToolTip.Tip="Unused Flags">🚩</Button>
						<Button Classes="ActivityButton" x:Name="BtnNavCommands" Click="OnSidebarNav_Click" Tag="Commands" ToolTip.Tip="Unused Works">🔨</Button>
						<Button Classes="ActivityButton" x:Name="BtnNavTheme" Click="OnSidebarNav_Click" Tag="Theme" ToolTip.Tip="Theme Settings">🎨</Button>
					</StackPanel>

					<StackPanel Grid.Row="1">
						<Button Classes="ActivityButton" x:Name="BtnNavPreview" Click="OnBottomNav_Click" Tag="Preview" ToolTip.Tip="Message Preview">👁</Button>
						<Button Classes="ActivityButton" x:Name="BtnNavTerminal" Click="OnBottomNav_Click" Tag="Terminal" ToolTip.Tip="Terminal (Ctrl+`)">💻</Button>
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Column="1" Background="#252526" x:Name="SidePanelContainer">
				<Grid>
					<Grid x:Name="PanelExplorer" RowDefinitions="35, *">
						<Border Grid.Row="0" Padding="10,0" Background="#252526">
							<TextBlock Text="EXPLORER" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center"/>
						</Border>
						<TreeView Grid.Row="1" x:Name="ScriptTree" Background="#252526" BorderThickness="0" SelectionChanged="ScriptTree_SelectionChanged">
							<TreeView.DataTemplates>
								<TreeDataTemplate DataType="models:FileNode" ItemsSource="{Binding Scripts}">
									<Grid ColumnDefinitions="Auto, *" Background="Transparent" DoubleTapped="OnExplorerItem_DoubleTapped">
										<TextBlock Text="{Binding Icon}" Foreground="#4EC9B0" Margin="0,0,6,0" FontFamily="Segoe UI Symbol"/>
										<TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
									</Grid>
								</TreeDataTemplate>
								<DataTemplate DataType="models:ScriptNode">
									<StackPanel Orientation="Horizontal" Background="Transparent" DoubleTapped="OnExplorerItem_DoubleTapped">
										<TextBlock Text="Js" Foreground="#D7BA7D" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
										<TextBlock Text="{Binding Label}" Foreground="#D7BA7D"/>
									</StackPanel>
								</DataTemplate>
							</TreeView.DataTemplates>
						</TreeView>
					</Grid>

					<Grid x:Name="PanelSearch" IsVisible="False" RowDefinitions="35, 35, *">
						<Border Grid.Row="0" Padding="10,0" Background="#252526">
							<Grid ColumnDefinitions="*, Auto">
								<TextBlock Text="SEARCH" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center"/>
								<Button Grid.Column="1" Content="↻" Padding="4,0" ToolTip.Tip="Refresh Search Index" Background="Transparent" Click="RefreshFlags_Click" BorderThickness="0"/>
							</Grid>
						</Border>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="#3C3C3C" CornerRadius="2">
							<TextBox x:Name="SearchBox" Watermark="Global search..." Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" TextChanged="SearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<ListBox Grid.Row="2" x:Name="SearchResultsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel/>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Expander Classes="SearchExpander" HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="0" Margin="0">
										<Expander.Header>
											<Grid ColumnDefinitions="Auto, Auto, *" Margin="2,0,0,0">
												<TextBlock Text="{Binding Type, Converter={StaticResource SearchTypeToIconConverter}}" Foreground="{Binding Color}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Segoe UI Symbol"/>
												<TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="#569CD6" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding Id}"/>
												<TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
											</Grid>
										</Expander.Header>
										<ItemsControl ItemsSource="{Binding Locations}" Background="Transparent" BorderThickness="0" Margin="0">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="25,2,5,2"
                                                            Click="JumpToLocation_Click"
                                                            PointerWheelChanged="SearchResult_PointerWheelChanged"
                                                            ToolTip.Placement="Right"
                                                            Tag="{Binding}">

														<ToolTip.Tip>
															<Border Background="#1E1E1E"
                                                                    BorderBrush="White"
                                                                    BorderThickness="1"
                                                                    CornerRadius="0"
                                                                    Padding="10"
                                                                    HorizontalAlignment="Left"
                                                                    MaxWidth="1200"
                                                                    MaxHeight="700">

																<ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Auto">
																	<ItemsControl>
																		<ItemsControl.ItemsSource>
																			<MultiBinding Converter="{StaticResource ScriptPreviewConverter}">
																				<Binding Path="NodeObject"/>
																				<Binding Path="LineNumber"/>
																				<Binding Path="#MainWindowRef.ThemeVm"/>
																			</MultiBinding>
																		</ItemsControl.ItemsSource>
																		<ItemsControl.ItemTemplate>
																			<DataTemplate>
																				<Border Background="{Binding Background}" Padding="2,0">
																					<Grid ColumnDefinitions="40, Auto">
																						<TextBlock Text="{Binding LineNumber}"
                                                                                                   Foreground="#606060"
                                                                                                   FontSize="10"
                                                                                                   Margin="0,0,15,0"
                                                                                                   TextAlignment="Right"
                                                                                                   VerticalAlignment="Center"/>

																						<ItemsControl Grid.Column="1" ItemsSource="{Binding Segments}">
																							<ItemsControl.ItemsPanel>
																								<ItemsPanelTemplate>
																									<StackPanel Orientation="Horizontal"/>
																								</ItemsPanelTemplate>
																							</ItemsControl.ItemsPanel>
																							<ItemsControl.ItemTemplate>
																								<DataTemplate>
																									<TextBlock Text="{Binding Text}"
                                                                                                               Foreground="{Binding Foreground}"
                                                                                                               FontWeight="{Binding Weight}"
                                                                                                               FontStyle="{Binding Style}"
                                                                                                               FontFamily="Consolas, Monospace"
                                                                                                               FontSize="11"/>
																								</DataTemplate>
																							</ItemsControl.ItemTemplate>
																						</ItemsControl>
																					</Grid>
																				</Border>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																</ScrollViewer>
															</Border>
														</ToolTip.Tip>

														<Grid ColumnDefinitions="Auto, *">
															<TextBlock Text="{Binding Command}" Foreground="#DCDCAA" FontSize="11" Margin="5,0"/>
															<TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#808080" FontSize="10" FontStyle="Italic" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Expander>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<Grid x:Name="PanelFlags" IsVisible="False" RowDefinitions="35, 35, *">
						<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,0">
							<TextBlock Text="UNUSED FLAGS" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center"/>
							<Button Grid.Column="1" Content="↻" Padding="4,0" ToolTip.Tip="Refresh" Background="Transparent" Click="RefreshFlags_Click" BorderThickness="0"/>
						</Grid>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="#3C3C3C" CornerRadius="2">
							<TextBox x:Name="FlagSearchBox" Watermark="Filter flags..." Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" TextChanged="FlagSearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<ListBox Grid.Row="2" x:Name="FlagList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="Auto, *">
										<TextBlock Text="🚩" Foreground="#569CD6" Margin="0,0,6,0" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="{Binding FlagName}" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<Grid x:Name="PanelCommands" IsVisible="False" RowDefinitions="35, 35, *">
						<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,0">
							<TextBlock Text="UNUSED WORKS" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center"/>
							<Button Grid.Column="1" Content="↻" Padding="4,0" ToolTip.Tip="Refresh" Background="Transparent" Click="RefreshScripts_Click" BorderThickness="0"/>
						</Grid>
						<Border Grid.Row="1" Margin="10,0,10,5" Background="#3C3C3C" CornerRadius="2">
							<TextBox x:Name="ScriptSearchBox" Watermark="Filter works..." Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" TextChanged="ScriptSearchBox_TextChanged" Padding="6,4"/>
						</Border>
						<ListBox Grid.Row="2" x:Name="ScriptList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="Auto, *">
										<TextBlock Text="🔨" Foreground="#CE9178" Margin="0,0,6,0" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="{Binding FlagName}" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<Grid x:Name="PanelTheme" IsVisible="False" RowDefinitions="35, Auto, *">
						<Grid Grid.Row="0" Margin="10,0">
							<TextBlock Text="THEME SETTINGS" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center"/>
						</Grid>
						<Border Grid.Row="1" Margin="10" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Background="{Binding Colors.BackgroundColor}" Padding="10">
							<StackPanel x:Name="PreviewBox">
								<TextBlock Text="Theme Preview Code..." Foreground="#888" FontSize="10"/>
							</StackPanel>
						</Border>
						<ScrollViewer Grid.Row="2" Margin="10,0">
							<StackPanel Spacing="15">
								<TextBlock Text="General" FontWeight="Bold" Foreground="#888" FontSize="12" Margin="0,5"/>
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="Editor Background" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<ColorPicker Grid.Column="1" Color="{Binding Colors.BackgroundColor, Mode=TwoWay}" />
								</Grid>
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="Editor Foreground" VerticalAlignment="Center" Foreground="#CCCCCC"/>
									<ColorPicker Grid.Column="1" Color="{Binding Colors.ForegroundColor, Mode=TwoWay}" />
								</Grid>
								<Button Content="Save Theme" HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="SaveTheme_Click"/>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>

			<GridSplitter Grid.Column="2" Background="#1E1E1E" ResizeDirection="Columns"/>

			<Grid x:Name="MainContentGrid" Grid.Column="3" Background="#1E1E1E" RowDefinitions="30, *, 4, Auto">

				<ListBox Grid.Row="0" x:Name="TabStrip" Classes="TabStrip" SelectionChanged="TabStrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid ColumnDefinitions="*, Auto" MinWidth="100">
								<TextBlock Text="{Binding Title}" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="5,0,10,0" FontStyle="{Binding FontStyle}"/>
								<Button Grid.Column="1" Content="✕" Click="BtnCloseTab_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Padding="2" FontSize="10" VerticalAlignment="Center"/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<Panel Grid.Row="1" Background="#1E1E1E">
					<webview:WebView x:Name="Editor" IsVisible="True"/>
					<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" x:Name="NoTabsPlaceholder">
						<TextBlock Text="Relumi Script Viewer" FontSize="24" Foreground="#333" HorizontalAlignment="Center"/>
						<TextBlock Text="Select a file to view or edit" FontSize="14" Foreground="#444" HorizontalAlignment="Center" Margin="0,10,0,0"/>
					</StackPanel>
				</Panel>

				<GridSplitter Grid.Row="2" Background="#1E1E1E" ResizeDirection="Rows" IsVisible="{Binding #BottomPanelContainer.IsVisible}"/>

				<Grid Grid.Row="3" x:Name="BottomPanelContainer" IsVisible="False" Height="250" Background="#1E1E1E">

					<Border x:Name="PreviewPanel" IsVisible="False" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0">
						<Grid RowDefinitions="Auto, *">
							<Border Grid.Row="0" Padding="10,5" Background="#252526">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="PREVIEW" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11"/>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
										<Button x:Name="BtnPrevPage" Content="◀" Padding="8,2" Background="Transparent" BorderThickness="0" Click="BtnPrevPage_Click" IsVisible="False"/>
										<TextBlock x:Name="PageIndicator" Text="" VerticalAlignment="Center" Foreground="#888" FontSize="11" IsVisible="False"/>
										<Button x:Name="BtnNextPage" Content="▶" Padding="8,2" Background="Transparent" BorderThickness="0" Click="BtnNextPage_Click" IsVisible="False"/>
										<Button Content="✕" Padding="5,0" Background="Transparent" BorderThickness="0" Click="BtnPreviewClose_Click" Foreground="#CCCCCC" FontSize="10" Margin="10,0,0,0"/>
									</StackPanel>
								</Grid>
							</Border>
							<Border Grid.Row="1" Padding="10" Background="#1E1E1E">
								<Viewbox Stretch="Uniform">
									<ContentControl x:Name="MessagePreviewContent"/>
								</Viewbox>
							</Border>
						</Grid>
					</Border>

					<Border x:Name="TerminalPanel" IsVisible="False" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0">
						<Grid RowDefinitions="Auto, *, Auto">
							<Border Grid.Row="0" Padding="10,5" Background="#252526">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="TERMINAL" FontWeight="Bold" Foreground="#BBBBBB" FontSize="11"/>
									<Button Grid.Column="1" Content="✕" Padding="5,0" Background="Transparent" BorderThickness="0" Click="BtnTerminalClose_Click" Foreground="#CCCCCC" FontSize="10"/>
								</Grid>
							</Border>
							<TextBox Grid.Row="1" x:Name="TerminalOutput" IsReadOnly="True" Background="#1E1E1E" Foreground="#CCCCCC" BorderThickness="0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"/>
							<TextBox Grid.Row="2" x:Name="TerminalInput" Background="#252526" Foreground="#E0E0E0" BorderBrush="#333" BorderThickness="0,1,0,0" FontFamily="Consolas" FontSize="12" KeyDown="TerminalInput_KeyDown"/>
						</Grid>
					</Border>

				</Grid>
			</Grid>
		</Grid>

		<Border Grid.Row="1" Background="#007ACC" Padding="10,0">
			<TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
		</Border>
	</Grid>
</Window>